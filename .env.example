# ─── Firebase (browser/web SDK) ──────────────────────────────────────
# These three values come from the Firebase console:
#   Project settings → General → Your apps → Web app → "SDK setup and configuration"
# They are public — safe to commit, safe to expose to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ─── Firebase Admin (server SDK) ─────────────────────────────────────
# Service-account credentials. Generate from:
#   Project settings → Service accounts → "Generate new private key"
# This downloads a JSON file. Either set the three values below, or
# base64-encode the entire JSON and set FIREBASE_SERVICE_ACCOUNT_B64.
#
# IMPORTANT: never commit these. Add to your hosting provider's secret
# store (Cloud Run env vars, Vercel project env, etc).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Alternative: base64-encoded service-account JSON. Use when your
# hosting provider can't handle multi-line env values.
# FIREBASE_SERVICE_ACCOUNT_B64=
#
# Or set FIREBASE_PROJECT_ID alone on Cloud Run to use the service's own
# service account (production does this; bw-heirloom-prod blocks keys).

# ─── Backend ─────────────────────────────────────────────────────────
# Laravel API base URL: the Phase 3 "Kinloom API". Lives on Forge for now and
# moves to GCP before the Founders launch. Required wherever NODE_ENV is
# production (a deployed server fails its first request without it). Under
# `next dev` it may be left unset and falls back to the Forge host.
KINLOOM_API_URL=https://kinloom-api-laravel-vycjbweb.on-forge.com/api

# ─── iOS app ─────────────────────────────────────────────────────────
# Universal Links for /invite/*. "TEAMID.bundle.id", comma separated.
# Leave unset until the iOS app is registered; the association file
# 404s without it.
# APPLE_APP_IDS=

# ─── Google Tag Manager ──────────────────────────────────────────────
# Container ID (GTM-XXXXXXX). Unset = no analytics loaded. Build-time:
# must be in .env.production when `next build` runs. Only the prod
# deploy sets it; dev, previews and local stay unset.
NEXT_PUBLIC_GTM_ID=

# ─── Feedback tool ───────────────────────────────────────────────────
# Must be exactly 1 to show the in-app feedback sheet. On in every deploy;
# reports go to FEEDBACK_INGEST_URL.
NEXT_PUBLIC_FEEDBACK_TOOL=0
# Optional build SHA shown on reports.
# NEXT_PUBLIC_APP_VERSION=
# Cloud Function that writes the review spreadsheet. Server-only.
FEEDBACK_INGEST_URL=https://us-east1-bw-heirloom-dev.cloudfunctions.net/feedback-ingest-dev

# ─── HubSpot contact sync (Phase 2) ──────────────────────────────────
# Server-only. Off unless exactly 1: the /api/analytics/sync route then
# returns 204 without reading or writing anything. Keep 0 locally and on
# dev/previews unless pointed at a HubSpot TEST portal.
HUBSPOT_SYNC_ENABLED=0
# Private app token (crm.objects.contacts.read + write; plus
# communication_preferences.write if the subscription opt-in is used).
# Prod: GCP Secret Manager, never a GitHub variable or NEXT_PUBLIC_.
HUBSPOT_PRIVATE_APP_TOKEN=
# Email subscription type id that the sign-up checkbox opts people into.
# The opt-in is only applied when HUBSPOT_LEGAL_BASIS_ENABLED=1 too;
# otherwise the choice is recorded as kinloom_marketing_opt_in only.
HUBSPOT_SUBSCRIPTION_ID=
HUBSPOT_LEGAL_BASIS_ENABLED=0
