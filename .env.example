# ─── Firebase (browser/web SDK) ──────────────────────────────────────
# These three values come from the Firebase console:
#   Project settings → General → Your apps → Web app → "SDK setup and configuration"
# They are public — safe to commit, safe to expose to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ─── Firebase Admin (server SDK) ─────────────────────────────────────
# Service-account credentials. Generate from:
#   Project settings → Service accounts → "Generate new private key"
# This downloads a JSON file. Either set the three values below, or
# base64-encode the entire JSON and set FIREBASE_SERVICE_ACCOUNT_B64.
#
# IMPORTANT: never commit these. Add to your hosting provider's secret
# store (Cloud Run env vars, Vercel project env, etc).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Alternative: base64-encoded service-account JSON. Use when your
# hosting provider can't handle multi-line env values.
# FIREBASE_SERVICE_ACCOUNT_B64=

# ─── Backend ─────────────────────────────────────────────────────────
# Laravel API base URL. Defaults to staging if unset.
KINLOOM_API_URL=https://kinloom-api-laravel-fz0wpjzb.on-forge.com/api

# ─── Feedback tool ───────────────────────────────────────────────────
# Must be exactly 1 to show the in-app feedback sheet.
NEXT_PUBLIC_FEEDBACK_TOOL=1
# Optional build SHA shown on reports.
# NEXT_PUBLIC_APP_VERSION=
# Cloud Function that writes the review spreadsheet. Server-only.
FEEDBACK_INGEST_URL=https://us-east1-bw-heirloom-dev.cloudfunctions.net/feedback-ingest-dev
